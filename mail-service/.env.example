# Rise Above Foundation — NodeMailer mail service
# Copy this file to mail-service/.env and fill in your values.
# Then run: npm run mail

# --- SMTP (Gmail) ---
# 1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste THAT 16-letter password below (NOT your normal Gmail password)
#    Example of what Google shows: abcd efgh ijkl mnop  →  remove spaces or keep them
# 4. Do NOT leave the fake value "PASTE_APP_PASSWORD_HERE"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=PASTE_APP_PASSWORD_HERE

# Deliverability: MAIL_FROM_EMAIL must match SMTP_USER for Gmail.
# Using a different From (custom domain) without Workspace/SPF/DKIM lands in Spam.
MAIL_FROM_EMAIL=your.gmail@gmail.com
MAIL_FROM_NAME=Rise Above Foundation
# Monitored address for replies (defaults to MAIL_FROM_EMAIL)
MAIL_REPLY_TO=your.gmail@gmail.com

MAIL_SERVICE_PORT=8025
MAIL_SERVICE_API_KEY=change-me-to-a-long-random-string

# Public SPA origin for email link fallbacks (PHP also passes absolute URLs).
# Local:  http://localhost:5173
# Prod:   https://your-production-domain.com
# You may set APP_URL instead of FRONTEND_URL — both are read.
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
RECOVERY_URL=http://localhost:5173/login
ORG_NAME=Rise Above Foundation Cebu

# Optional: mailto used only if marketing List-Unsubscribe is enabled
# MAIL_LIST_UNSUBSCRIBE=your.gmail@gmail.com
