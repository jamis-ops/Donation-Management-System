# Rise Above Foundation — NodeMailer mail service
# Copy this file to mail-service/.env and fill in your values.
# Then run: npm run mail

# --- SMTP (Gmail) ---
# 1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste THAT 16-letter password below (NOT your normal Gmail password)
#    Example of what Google shows: abcd efgh ijkl mnop  →  remove spaces or keep them
# 4. Do NOT leave the fake value "PASTE_APP_PASSWORD_HERE"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=jamesisidro0808@gmail.com
SMTP_PASS=rhni aarh qlkc ocpl

MAIL_FROM_EMAIL=jamesisidro0808@gmail.com
MAIL_FROM_NAME=Rise Above Foundation

MAIL_SERVICE_PORT=8025
MAIL_SERVICE_API_KEY=change-me-to-a-long-random-string

FRONTEND_URL=http://localhost:5173
